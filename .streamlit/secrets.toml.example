# Copia este archivo como .streamlit/secrets.toml y llena los valores.
# secrets.toml NUNCA se sube al repositorio (está en .gitignore).
# En Streamlit Community Cloud pega este contenido en: App > Settings > Secrets.

[supabase]
url = "https://TU-PROYECTO.supabase.co"
# service_role key: solo vive en el servidor de Streamlit, nunca en el navegador.
service_role_key = "REEMPLAZAR"

[admin]
# Contraseña del panel del docente en /admin (mínimo 12 caracteres; usa una larga y única).
# Tras 5 intentos fallidos desde un mismo equipo se bloquea 15 minutos.
password = "REEMPLAZAR"

[app]
# URL pública de la app (se usa para generar el QR).
public_url = "https://tu-app.streamlit.app"
# Si es true (por defecto), el alumno ve y descarga sus resultados (PDF y Excel) al terminar.
MOSTRAR_RESULTADO_AL_ALUMNO = true

[correo]
# Envío automático del reporte en PDF al correo del alumno al terminar. Sin esta sección el envío queda
# desactivado (el alumno igual puede descargar su PDF y la coordinación lo envía después desde /admin).
# Usa una cuenta de Gmail creada solo para esto: activa la verificación en dos pasos y genera una
# "contraseña de aplicación" (Cuenta de Google > Seguridad > Contraseñas de aplicaciones). NO uses la contraseña normal.
servidor = "smtp.gmail.com"
puerto = 465          # 465 = SSL, 587 = STARTTLS
usuario = "reportes.tu-cuenta@gmail.com"
contrasena = "REEMPLAZAR"
remitente = "reportes.tu-cuenta@gmail.com"
